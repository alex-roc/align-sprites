{
  "name": "align-sprites",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "bin": {
    "align-sprites": "cli/align-sprites.ts"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:godot": "node scripts/godot-validate.mjs",
    "test:godot:tiles": "node scripts/godot-validate-tiles.mjs",
    "test:godot:items": "node scripts/godot-validate-items.mjs",
    "test:godot:parallax": "node scripts/godot-validate-parallax.mjs",
    "cli": "node cli/align-sprites.ts"
  },
  "dependencies": {
    "@fontsource-variable/atkinson-hyperlegible-next": "^5.3.0",
    "@fontsource/pixelify-sans": "^5.3.0",
    "comlink": "^4.4.2",
    "fast-png": "^8.0.0",
    "fflate": "^0.8.3",
    "kaplay": "3001.0.19",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.89.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "license": "GPL-3.0-or-later",
  "description": "Normalize AI-generated sprites and tiles for Godot, GDevelop and Kaplay: fixed cells, shared scale, feet alignment, true pixel grid.",
  "packageManager": "pnpm@11.17.0"
}
